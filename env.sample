# TradingAgents Environment Configuration
# ======================================
# Instructions:
# 1. Copy this file to ".env".
# 2. Replace placeholder values with your own keys.
# 3. Restart the CLI/WebUI after changing this file.
#
# Keep ALPACA_USE_PAPER=True while testing. Set it to False only when you
# intentionally want live Alpaca trading.


# ---------------------------------------------------------------------------
# Runtime Paths
# ---------------------------------------------------------------------------

# Optional. Defaults to "eval_results".
TRADINGAGENTS_RESULTS_DIR=eval_results

# Optional. Defaults to tradingagents/dataflows/data_cache.
TRADINGAGENTS_CACHE_DIR=tradingagents/dataflows/data_cache

# Optional. Defaults to ~/.tradingagents/memory/trading_memory.md.
TRADINGAGENTS_MEMORY_LOG_PATH=~/.tradingagents/memory/trading_memory.md

# Optional. Override selected bundled model prompt templates with Markdown files.
# Keep grouped paths, for example analysts/market_system.md.
# Missing files fall back to tradingagents/prompts/templates.
TRADINGAGENTS_PROMPT_DIR=


# ---------------------------------------------------------------------------
# Durable Persistence
# ---------------------------------------------------------------------------

# PostgreSQL is optional until the persistence cutover is enabled. The default
# below connects from the host; Docker Compose overrides the hostname to
# "postgres" for the web container.
DATABASE_URL=postgresql+psycopg://tradingagents:tradingagents@localhost:5432/tradingagents
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_STATEMENT_TIMEOUT_MS=30000

# local keeps the existing SQLite/JSONL stores. postgres enables transactional
# lifecycle and decision-event writes. Docker Compose selects postgres.
PERSISTENCE_BACKEND=local

# Evaluation worker market data is independent of execution_broker. Supported
# values: alpaca or tradier. Tradier uses the credentials below.
EVALUATION_PRICE_PROVIDER=alpaca
EVALUATION_HORIZONS_DAYS=1,5,20
EVALUATION_ESTIMATED_COST_PCT=0.10
EVALUATION_WORKER_INTERVAL_SECONDS=300
EVALUATION_BENCHMARK_SYMBOL=SPY
EVALUATION_EXPERIMENT_ID=default

RECONCILIATION_WORKER_INTERVAL_SECONDS=5
RECONCILIATION_WORKER_BATCH_SIZE=25
RECONCILIATION_LEASE_SECONDS=60
RECONCILIATION_POLL_SECONDS=5
RECONCILIATION_MAX_RETRY_SECONDS=300

# Used by the bundled PostgreSQL container. Replace these values outside local
# development and do not commit production credentials.
POSTGRES_DB=tradingagents
POSTGRES_USER=tradingagents
POSTGRES_PASSWORD=tradingagents

# Enables encrypted, server-side provider credential management in the Web UI.
# Generate once with: python -m tradingagents.integrations generate-key
# Keep this value stable and outside database backups; losing it makes stored
# provider credentials unrecoverable.
INTEGRATION_VAULT_KEY=
INTEGRATION_VAULT_SCOPE=default


# ---------------------------------------------------------------------------
# LLM Provider Selection
# ---------------------------------------------------------------------------

# Supported values:
# openai, local_openai, google, anthropic, xai, minimax, deepseek, qwen, glm,
# openrouter, ollama, azure
LLM_PROVIDER=openai


# ---------------------------------------------------------------------------
# OpenAI and Local OpenAI-Compatible Endpoints
# ---------------------------------------------------------------------------

# Required for OpenAI models and OpenAI web-search data tools.
# Also used by memory embeddings unless OPENAI_USE_LOCAL points embeddings to
# a compatible local endpoint.
OPENAI_API_KEY=your_openai_api_key_here

# Set true to route core LLM and embedding calls to OPENAI_BASE_URL.
# OpenAI web-search tools still require OPENAI_API_KEY because local endpoints
# usually do not support OpenAI Responses web search.
OPENAI_USE_LOCAL=false

# Examples:
# LM Studio: http://localhost:1234/v1
# Ollama OpenAI compatibility: http://localhost:11434/v1
# vLLM OpenAI server: http://localhost:8000/v1
OPENAI_BASE_URL=http://localhost:1234/v1

# Optional embedding model override for memory.
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002


# ---------------------------------------------------------------------------
# Non-OpenAI LLM Providers
# ---------------------------------------------------------------------------

# Google Gemini
GOOGLE_API_KEY=your_google_api_key_here

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# xAI Grok
XAI_API_KEY=your_xai_api_key_here

# MiniMax (official OpenAI-compatible endpoint: https://api.minimax.io/v1)
MINIMAX_API_KEY=your_minimax_api_key_here

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Alibaba Qwen via DashScope OpenAI-compatible endpoint
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Zhipu GLM
ZHIPU_API_KEY=your_zhipu_api_key_here

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Ollama does not require an API key by default. Use backend_url in the UI/CLI
# or OPENAI_BASE_URL with LLM_PROVIDER=local_openai for OpenAI compatibility.


# ---------------------------------------------------------------------------
# Azure OpenAI
# ---------------------------------------------------------------------------

AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment_name
AZURE_OPENAI_API_VERSION=2024-12-01-preview


# ---------------------------------------------------------------------------
# Trading, Market Data, News, and Macro APIs
# ---------------------------------------------------------------------------

# Alpaca is required for market data and optional order execution.
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_USE_PAPER=True

# Software stops are disabled by default because they can submit position-close
# orders from a background thread. Enable only after reviewing stored stops.
VIRTUAL_STOPS_DAEMON_ENABLED=false
# Required in addition to the daemon switch when ALPACA_USE_PAPER=False.
VIRTUAL_STOPS_LIVE_ENABLED=false

# Tradier additional broker. Select it with execution_broker="tradier" in
# application configuration. Keep sandbox enabled during validation.
TRADIER_ACCESS_TOKEN=your_tradier_sandbox_token_here
TRADIER_ACCOUNT_ID=your_tradier_account_id_here
TRADIER_USE_SANDBOX=True

# Robinhood trading MCP additional broker. Obtain the OAuth access token using
# Robinhood's MCP authorization flow, or point to a JSON token cache. Review-only
# mode calls review_equity_order but never place_equity_order.
ROBINHOOD_MCP_ACCESS_TOKEN=
ROBINHOOD_MCP_TOKEN_PATH=~/.tradingagents/robinhood/oauth_token.json
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
ROBINHOOD_ACCOUNT_NUMBER=
ROBINHOOD_MCP_REVIEW_ONLY=True
ROBINHOOD_MCP_LIVE_ORDERS_ENABLED=False
ROBINHOOD_MCP_TIMEOUT_SECONDS=20

# Finnhub is used for equity news, insider sentiment/transactions, and
# earnings calendar data.
FINNHUB_API_KEY=your_finnhub_api_key_here

# FRED is used by the macro analyst.
FRED_API_KEY=your_fred_api_key_here

# CryptoCompare/CoinDesk-compatible news source used for crypto analysis.
COINDESK_API_KEY=your_cryptocompare_api_key_here

# Optional fallback market data source.
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here


# ---------------------------------------------------------------------------
# Quantitative Screener Configuration
# ---------------------------------------------------------------------------

SCREENER_ENABLED=true
SCREENER_SCAN_INTERVAL_MIN=30        # Minutes between stock scans (during market hours)
SCREENER_CRYPTO_INTERVAL_H=4         # Hours between crypto scans (24/7)
SCREENER_COOLDOWN_HOURS=24.0         # Hours before re-analyzing same ticker
SCREENER_MIN_SCORE_STOCK=7.0         # Minimum score threshold for stocks (0-10)
SCREENER_MIN_SCORE_CRYPTO=4.0        # Minimum score threshold for crypto (0-10)
SCREENER_MAX_CANDIDATES=3            # Max candidates per scan cycle
SCREENER_MIN_VOLUME=500000           # Minimum 20-day average volume (stocks)

# ---------------------------------------------------------------------------
# Headless autonomous worker (opt-in; start with dry-run)
# ---------------------------------------------------------------------------

AUTONOMOUS_ENABLED=false
AUTONOMOUS_ACCOUNT_KEY=alpaca:paper-primary
EXECUTION_BROKER=alpaca              # alpaca, tradier, or robinhood
EXECUTION_GATEWAY=dry-run            # dry-run or broker
AUTONOMOUS_INTERVAL_SECONDS=1800
AUTONOMOUS_ASSET_FILTER=all           # all, stock, or crypto
AUTONOMOUS_MAX_CANDIDATES=3
AUTONOMOUS_MAX_CONCURRENCY=2
AUTONOMOUS_PROVIDER_CONCURRENCY=2
AUTONOMOUS_PROVIDER_MIN_INTERVAL_SECONDS=0.25
AUTONOMOUS_ANALYSIS_RETRIES=1
AUTONOMOUS_REQUESTED_NOTIONAL_USD=1000
AUTONOMOUS_RESERVATION_TTL_SECONDS=300
AUTONOMOUS_DISPATCH_LEASE_SECONDS=60
AUTONOMOUS_ESTIMATED_TOKENS_PER_ANALYSIS=0
AUTONOMOUS_ANALYSTS=market,social,news,fundamentals,macro
AUTONOMOUS_EXPERIMENT_SEED=default
# JSON list. Exactly zero or one variant may set execution_eligible=true.
# Example challenger: [{"experiment_id":"champion","weight":9,"execution_eligible":true,"config_overrides":{}},{"experiment_id":"gpt-challenger","weight":1,"execution_eligible":false,"config_overrides":{"deep_think_llm":"gpt-5.4"}}]
AUTONOMOUS_EXPERIMENTS_JSON=[{"experiment_id":"champion","weight":1,"execution_eligible":true,"config_overrides":{}}]
