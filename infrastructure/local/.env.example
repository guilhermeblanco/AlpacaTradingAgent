# =============================================================================
# TradingAgents — deployment environment
#
#   cp .env.example .env && $EDITOR .env
#
# This file is the deployment's own settings: the database it talks to, the
# keys it authenticates with, and the two switches that decide whether it can
# trade. Every service in the stack receives it whole.
#
# It is a curated subset, not the full list. ../../env.sample documents every
# tunable the application reads — screener thresholds, per-provider model
# choices, reconciliation timings, the integration vault. Anything you add
# here is passed straight through, so reach for that file when you want to
# change behaviour rather than topology.
#
# Keep this file at mode 0600. It holds live broker credentials.
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
# POSTGRES_MODE=external (the default): set DATABASE_URL to a server you
# already run. `infrastructure/proxmox/postgres-database.sh` provisions the
# role and database on an existing PostgreSQL LXC and prints this line.
#
# POSTGRES_MODE=local: leave DATABASE_URL blank. The Makefile composes it from
# POSTGRES_USER/PASSWORD/DB below and points it at the in-stack container, and
# anything written here is ignored — the topology decides the host, not a file.
#
# A password containing @ : / or ? must be percent-encoded here. That is the
# main reason this is one URL rather than four parts.
DATABASE_URL=postgresql+psycopg://tradingagents:change-me@10.64.8.78:5432/tradingagents

POSTGRES_DB=tradingagents
POSTGRES_USER=tradingagents
POSTGRES_PASSWORD=change-me

PERSISTENCE_BACKEND=postgres

# The encrypted credential vault. With this set, the setup wizard can store
# broker and model keys in PostgreSQL — encrypted, never returned to the
# browser, rotatable without a redeploy. Without it the wizard has nowhere
# to put anything and says so, and every credential has to be set in this
# file instead.
#
#   python -m tradingagents.integrations generate-key
#
# Losing this key makes every stored credential unreadable. It is not
# derived from anything and there is no recovery: back it up with the
# database, or accept re-entering the keys.
INTEGRATION_VAULT_KEY=
INTEGRATION_VAULT_SCOPE=default

# Which broker account this deployment's safety state belongs to. Two
# deployments sharing a database must NOT share a scope, or one will lift the
# other's quarantines.
SAFETY_STATE_SCOPE=alpaca:paper-primary

# ── Where the workbench listens ──────────────────────────────────────────────
# HOST_BIND=127.0.0.1 keeps it on loopback (a laptop). The Proxmox deployment
# sets 0.0.0.0, where the LXC boundary is the access control — there is no
# authentication in front of this UI, so do not publish it to an untrusted
# network.
HOST_BIND=127.0.0.1
HOST_PORT=7860
TZ=America/New_York

# ── Can it trade? ────────────────────────────────────────────────────────────
# Both default to no, and both have to change before an order can reach a
# broker without a human clicking it. The autonomous worker also has to be
# started by name: AUTONOMOUS=1 make up.
#
# The useful intermediate state is AUTONOMOUS_ENABLED=true with
# EXECUTION_GATEWAY=dry-run: the whole pipeline runs and journals what it
# would have done, and you can read the gate ledgers for a week before
# deciding.
AUTONOMOUS_ENABLED=false
EXECUTION_GATEWAY=dry-run
EXECUTION_BROKER=alpaca
AUTONOMOUS_ACCOUNT_KEY=alpaca:paper-primary
AUTONOMOUS_INTERVAL_SECONDS=1800
AUTONOMOUS_REQUESTED_NOTIONAL_USD=1000

# ── Broker ───────────────────────────────────────────────────────────────────
# ALPACA_USE_PAPER=True is the paper account. Check this line specifically
# before you change EXECUTION_GATEWAY to broker.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_USE_PAPER=True

# ── Models ───────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ── Market data ──────────────────────────────────────────────────────────────
FINNHUB_API_KEY=
# FRED_API_KEY=
# ALPHA_VANTAGE_API_KEY=

# ── Evaluation ───────────────────────────────────────────────────────────────
EVALUATION_PRICE_PROVIDER=alpaca
EVALUATION_HORIZONS_DAYS=1,5,20
EVALUATION_BENCHMARK_SYMBOL=SPY
EVALUATION_WORKER_INTERVAL_SECONDS=300

# ── Build ────────────────────────────────────────────────────────────────────
# Which network `make build` gives the image's RUN steps. Leave unset and
# podman decides, which is right nearly everywhere. Inside a nested
# unprivileged LXC podman's choice can fail to configure a namespace at all;
# `host` lends the build the container's own network, which is all apt and pip
# need. The Proxmox script probes for this and writes the answer here.
# BUILD_NETWORK=

# ── Point-in-time sourcing ───────────────────────────────────────────────────
# Live web search cannot be constrained to a past window, so it stands down
# automatically for any analysis of a past date. Set this true to stand it
# down for current dates too — worth doing while reproducing a run, at the
# cost of recall.
# REQUIRE_POINT_IN_TIME_WEB_SEARCH=false
